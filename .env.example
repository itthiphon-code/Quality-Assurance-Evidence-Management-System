# ===== Postgres (docker-compose) =====
POSTGRES_USER=qaems
POSTGRES_PASSWORD=qaems_dev_password
POSTGRES_DB=qaems
POSTGRES_PORT=5432

# ===== MinIO (docker-compose) =====
MINIO_ROOT_USER=qaems_minio
MINIO_ROOT_PASSWORD=qaems_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=qaems-evidence
MINIO_USE_SSL=false

# ===== Backend =====
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://qaems:qaems_dev_password@localhost:5432/qaems?schema=public
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# จำนวนชั้นพร็อกซีหน้า backend — dev เรียกตรง = 0, production หลัง NPM+nginx = 2
TRUST_PROXY_HOPS=0
PRESIGNED_URL_EXPIRES_SECONDS=600
# ตั้ง true เฉพาะ dev เท่านั้น — seed จะสร้างบัญชีตัวอย่าง 4 บทบาทพร้อมรหัสผ่านที่เผยแพร่ใน README
# ถ้าไม่ตั้ง (หรือ false) seed จะสร้างเฉพาะข้อมูลมาตรฐาน/ตัวชี้วัด และบัญชี qa ตั้งต้น 1 บัญชีพร้อมรหัสผ่านสุ่ม
SEED_DEMO_USERS=true

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:4000/api

# ===== Production only (docker-compose.prod.yml) =====
# ค่าด้านบนใช้ค่าเดียวกันได้ทั้ง dev/prod ยกเว้นต้องตั้งเป็นค่าจริงที่ปลอดภัย (รหัสผ่าน/secret แข็งแรง)
# CORS_ORIGIN ต้องตั้งเป็นโดเมนจริงของ frontend (เช่น https://qaems.example.ac.th)
# HTTP_PORT=80
